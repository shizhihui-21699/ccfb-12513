<div class="card">
  <h2>身份核验单</h2>
  <p>
    状态：
    <%= link_to "全部", admin_verifications_path %> |
    <%= link_to "待核验", admin_verifications_path(status: "pending") %> |
    <%= link_to "已通过", admin_verifications_path(status: "passed") %> |
    <%= link_to "未通过", admin_verifications_path(status: "failed") %>
    &nbsp;&nbsp;方式：
    <%= link_to "邮箱验证码", admin_verifications_path(method: "email_code") %> |
    <%= link_to "安全问题", admin_verifications_path(method: "security_question") %> |
    <%= link_to "人工审核", admin_verifications_path(method: "manual_review") %>
  </p>
  <table class="data">
    <tr><th>单号</th><th>时间</th><th>手机号</th><th>方式</th><th>状态</th><th>处理时间</th><th>备注</th><th></th></tr>
    <% @verifications.each do |v| %>
      <tr>
        <td>#<%= v.id %></td>
        <td><%= l v.created_at, format: :short %></td>
        <td class="mono"><%= v.user.phone %></td>
        <td><%= v.method_text %></td>
        <td><span class="tag <%= v.pending? ? 'tag-yellow' : (v.passed? ? 'tag-green' : 'tag-red') %>"><%= v.status_text %></span></td>
        <td><%= v.reviewed_at ? l(v.reviewed_at, format: :short) : "—" %></td>
        <td><%= truncate(v.admin_note.to_s, length: 30) %></td>
        <td><%= link_to "详情", admin_verification_path(v) %></td>
      </tr>
    <% end %>
  </table>
</div>
